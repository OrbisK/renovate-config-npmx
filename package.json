{
  "name": "renovate-config-npmx",
  "type": "module",
  "version": "0.0.7",
  "packageManager": "pnpm@10.33.0",
  "description": "Renovate preset that adds npmx.dev badges to PR bodies",
  "license": "ISC",
  "scripts": {
    "release": "bumpp",
    "validate-renovate": "pnpx --package renovate -- renovate-config-validator --strict $(ls *.json | grep -v package.json)"
  },
  "devDependencies": {
    "bumpp": "^11.0.1"
  }
}
